# Copy to .env and fill in. Never commit .env.

# Claude (teach mode, disagreement calls, weekly report)
ANTHROPIC_API_KEY=

# Bitdeer Model Studio (tier-2 vision checks, OpenAI-compatible API)
BITDEER_API_KEY=

# Cartesia (streaming TTS, voice clone, STT)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Factory Droid SDK (checker compiler)
FACTORY_API_KEY=

# SpacetimeDB (live floor)
SPACETIMEDB_HOST=https://maincloud.spacetimedb.com
SPACETIMEDB_MODULE=

# Moss (in-process guidance retrieval)
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# Google AI Studio (live step check stand-in while Bitdeer is paused)
GEMINI_API_KEY=
