# Copy to .env and fill in. Never commit .env.

# Claude: teach from video (Opus), live step checks and spoken answers (Sonnet)
ANTHROPIC_API_KEY=

# Cartesia: TTS in the supervisor's cloned voice, speech-to-text, voice cloning (with consent)
CARTESIA_API_KEY=
# optional: stock voice used only if no consented clone exists
CARTESIA_VOICE_ID=

# Moss: per-worker memory (mistakes, preferences, progress)
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# SpacetimeDB: only needed when config.yaml spacetimedb.target is "maincloud" (default is a local server)
SPACETIMEDB_HOST=https://maincloud.spacetimedb.com
SPACETIMEDB_MODULE=

# Bitdeer AI Model Studio: model comparison / eval scripts (not in the live path)
BITDEER_API_KEY=

# Optional, unused by the live product (kill-tests only)
FACTORY_API_KEY=
GEMINI_API_KEY=
