# Starts the camera + microphone stream when the Pi boots, and restarts it if it dies.
# Install (on the Pi):
#   sudo cp ~/stepwise_camera/stepwise-camera.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now stepwise-camera
# Logs: journalctl -u stepwise-camera -f
[Unit]
Description=Stepwise camera and microphone stream
After=network.target sound.target

[Service]
User=pi
WorkingDirectory=/home/pi/stepwise_camera
ExecStart=/usr/bin/python3 -u uvc_streamer.py --rotate 270
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
